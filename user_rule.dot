    "51" -> "T" [style = solid;];
    "52" [label = "x_6_0";];
    "52" -> "T" [style = dashed;];
    "52" -> "51" [style = solid;];
    "53" [label = "x_5_1";];
    "53" -> "52" [style = dashed;];
    "53" -> "T" [style = solid;];
    "54" [label = "x_3_1";];
    "54" -> "53" [style = dashed;];
    "54" -> "T" [style = solid;];
    "55" [label = "x_1_0";];
    "55" -> "54" [style = dashed;];
    "55" -> "T" [style = solid;];
    "56" [label = "x_0_1";];
