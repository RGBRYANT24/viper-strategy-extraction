digraph BDD {
    rankdir = TB;
    node [shape = circle;];
    // Terminal nodes
    "T" [shape = box;label = "True";style = filled;color = lightgrey;];
    "F" [shape = box;label = "False";style = filled;color = lightgrey;];
    "46" [label = "x_8_1";];
    "46" -> "F" [style = dashed;];
    "46" -> "T" [style = solid;];
    "48" [label = "x_8_0";];
